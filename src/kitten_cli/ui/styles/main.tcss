/* Main Stylesheet for Kitten CLI */

MainScreen {
    layout: vertical;
    background: $background;
}

AppHeader {
    height: 5;
    dock: top;
    background: $panel;
    color: $text;
    padding: 0 2;
    border-bottom: solid $primary;
}

.header-logo {
    color: $accent;
    text-style: bold;
}

MainContent {
    height: 1fr;
    background: $background;
    padding: 1 2;
}

#chat-history {
    height: 1fr;
    scrollbar-size: 1 1;
}

.chat-message {
    padding: 1 2;
    margin-bottom: 1;
    border: solid $surface-light;
    width: 100%;
}

.ai-message {
    border-left: thick $primary;
    background: $surface;
}

.user-message {
    border-left: thick $accent;
    background: $surface;
}

AppFooter {
    height: 3;
    dock: bottom;
    background: $panel;
    color: $text-muted;
    padding: 1 2;
    border-top: solid $surface-light;
}
