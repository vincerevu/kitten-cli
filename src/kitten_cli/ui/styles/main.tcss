/* Main Stylesheet for Kitten CLI */

MainScreen {
    background: $background;
    color: $foreground;
}

Header {
    dock: top;
    height: 1;
    background: $primary;
    color: $background;
}

Footer {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $foreground;
}

#chat-list {
    height: 1fr;
    background: $background;
}

#composer-container {
    dock: bottom;
    height: auto;
    border-top: solid $gray;
    background: $background;
}

Composer {
    height: auto;
    max-height: 10;
    border: none;
    background: $surface;
}

/* Primitives */
SpinnerWidget {
    color: $accent-cyan;
}

StatusWidget {
    margin: 1 0;
    color: $accent-cyan;
}

.status-icon {
    color: $accent-cyan;
}
.status-text {
    color: $gray;
}

DataTable {
    background: $background;
    border: none;
}

/* History */
MessageBubble {
    margin: 1 2;
    padding: 1 2;
    background: $surface;
    border-left: thick $primary;
}

MessageBubble.user {
    border-left: none;
    border-right: thick $accent;
    background: $background;
}

.bubble-sender {
    color: $gray;
    text-style: bold;
    margin-bottom: 1;
}

.bubble-content {
    color: $foreground;
}
